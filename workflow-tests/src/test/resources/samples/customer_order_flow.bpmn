      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_final_join_di" bpmnElement="e_final_join">
        <di:waypoint x="570" y="808" />
        <di:waypoint x="320" y="960" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_join_cc_di" bpmnElement="e_join_cc">
        <di:waypoint x="320" y="960" />
        <di:waypoint x="306" y="1088" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_mt2al5so_l5yhg3_di" bpmnElement="e_mt2al5so_l5yhg3">
        <di:waypoint x="310" y="1582" />
        <di:waypoint x="310" y="1658" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="loop_temple_node_to_loop_node_loop_gw_di" bpmnElement="loop_temple_node_to_loop_node_loop_gw">
