<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                 xmlns:flowable="http://flowable.org/bpmn"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 targetNamespace="http://flowable.org/bpmn">
  <bpmn:process id="customer_order_flow" name="规格书完整流程" isExecutable="true">
    <bpmn:startEvent id="startEvent" name="开始" />
    <bpmn:userTask id="edraft_submit" name="提交电子稿信息" flowable:assignee="${assignee}">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${edraft_submitApprovers}" flowable:elementVariable="assignee">
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression"><![CDATA[${nrOfCompletedInstances >= 1}]]>        </bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
    <bpmn:userTask id="edraft_confirm" name="客户确认电子稿" flowable:assignee="${edraft_confirmApprover}" />
    <bpmn:userTask id="spec_no_fill" name="填写规格书编号" flowable:assignee="${spec_no_fillApprover}" />
    <bpmn:userTask id="design_review" name="设计审核" flowable:assignee="${design_reviewApprover}" />
    <bpmn:userTask id="biz_review" name="业务审核" flowable:assignee="${biz_reviewApprover}" />
    <bpmn:userTask id="final_review" name="生产审核" flowable:assignee="${final_reviewApprover}" />
    <bpmn:serviceTask id="cc_node" name="抄送" flowable:delegateExpression="${ccNotificationDelegate}" />
    <bpmn:userTask id="write_epc" name="写码信息" flowable:assignee="${write_epcApprover}" />
    <bpmn:userTask id="resubmit_1" name="退回修改" flowable:assignee="${resubmit_1Approver}" />
    <bpmn:userTask id="userTask_7" name="包装信息" flowable:assignee="${userTask_7Approver}" />
    <bpmn:exclusiveGateway id="gw_confirm" name="客户确认结果" />
    <bpmn:parallelGateway id="gw_parallel_fork" name="并行网关" />
    <bpmn:parallelGateway id="gw_parallel_join" name="并行网关" />
    <bpmn:parallelGateway id="parallelGateway_3" />
    <bpmn:parallelGateway id="parallelGateway_4" name="写码信息和包装信息出口" />
    <bpmn:endEvent id="endEvent_approve" name="结束" />
    <bpmn:userTask id="loop_temple_node" name="模板名称填写" flowable:assignee="${loop_temple_nodeApprover}" />
    <bpmn:serviceTask id="loop_cc_node" name="循环内抄送" flowable:delegateExpression="${ccNotificationDelegate}" />
    <bpmn:exclusiveGateway id="loop_node_loop_gw" name="循环判断" />
    <bpmn:sequenceFlow id="loop_temple_node_to_loop_node_loop_gw" sourceRef="loop_temple_node" targetRef="loop_node_loop_gw" />
    <bpmn:sequenceFlow id="loop_node_loop_gw_to_loop_temple_node" sourceRef="loop_node_loop_gw" targetRef="loop_temple_node" name="继续循环">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${loopContinue == true}]]>      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="loop_node_loop_gw_exit" sourceRef="loop_node_loop_gw" targetRef="endEvent_approve" name="退出循环">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${loopContinue == false}]]>      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="parallelGateway_4_to_loop_temple_node" sourceRef="parallelGateway_4" targetRef="loop_temple_node" />
    <bpmn:sequenceFlow id="e1" sourceRef="startEvent" targetRef="edraft_submit" />
    <bpmn:sequenceFlow id="e2" sourceRef="edraft_submit" targetRef="edraft_confirm" />
    <bpmn:sequenceFlow id="e3" sourceRef="edraft_confirm" targetRef="gw_confirm" />
    <bpmn:sequenceFlow id="e4" sourceRef="gw_confirm" targetRef="spec_no_fill">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${approved == true}]]>      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e5" sourceRef="gw_confirm" targetRef="edraft_submit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${approved == false&& resubmitRequired == false}]]>      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_mtjncyka_lpcha2" sourceRef="gw_confirm" targetRef="resubmit_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${approved == false && resubmitRequired == true}]]>      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_mtjnd09z_j3zdke" sourceRef="resubmit_1" targetRef="edraft_submit" />
    <bpmn:sequenceFlow id="e_mtts0y0u_fumrss" sourceRef="cc_node" targetRef="parallelGateway_3" />
    <bpmn:sequenceFlow id="e_mtts118o_mfzp7s" sourceRef="parallelGateway_3" targetRef="write_epc" />
    <bpmn:sequenceFlow id="e_mtts1c1m_eb6faj" sourceRef="parallelGateway_3" targetRef="userTask_7" />
    <bpmn:sequenceFlow id="e_mtts1rod_pjj17s" sourceRef="write_epc" targetRef="parallelGateway_4" />
    <bpmn:sequenceFlow id="e_mtts1x7d_joy92d" sourceRef="userTask_7" targetRef="parallelGateway_4" />
    <bpmn:sequenceFlow id="e_spec_fork" sourceRef="spec_no_fill" targetRef="gw_parallel_fork" />
    <bpmn:sequenceFlow id="e_fork_design" sourceRef="gw_parallel_fork" targetRef="design_review" />
    <bpmn:sequenceFlow id="e_fork_biz" sourceRef="gw_parallel_fork" targetRef="biz_review" />
    <bpmn:sequenceFlow id="e_fork_final" sourceRef="gw_parallel_fork" targetRef="final_review" />
    <bpmn:sequenceFlow id="e_design_join" sourceRef="design_review" targetRef="gw_parallel_join" />
    <bpmn:sequenceFlow id="e_biz_join" sourceRef="biz_review" targetRef="gw_parallel_join" />
    <bpmn:sequenceFlow id="e_final_join" sourceRef="final_review" targetRef="gw_parallel_join" />
    <bpmn:sequenceFlow id="e_join_cc" sourceRef="gw_parallel_join" targetRef="cc_node" />
    <bpmn:sequenceFlow id="e_mt2al5so_l5yhg3" sourceRef="loop_temple_node" targetRef="loop_cc_node" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_customer_order_flow" bpmnElement="customer_order_flow">
      <bpmndi:BPMNShape id="spec_no_fill_di" bpmnElement="spec_no_fill">
        <dc:Bounds x="240" y="500" width="160" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="edraft_submit_di" bpmnElement="edraft_submit">
        <dc:Bounds x="240" y="140" width="160" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="edraft_confirm_di" bpmnElement="edraft_confirm">
        <dc:Bounds x="400" y="290" width="160" height="56" />
