      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_mtts1x7d_joy92d_di" bpmnElement="e_mtts1x7d_joy92d">
        <di:waypoint x="490" y="1278" />
        <di:waypoint x="310" y="1384" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_spec_fork_di" bpmnElement="e_spec_fork">
        <di:waypoint x="320" y="528" />
        <di:waypoint x="320" y="650" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_fork_design_di" bpmnElement="e_fork_design">
        <di:waypoint x="320" y="650" />
        <di:waypoint x="100" y="808" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_fork_biz_di" bpmnElement="e_fork_biz">
        <di:waypoint x="320" y="650" />
        <di:waypoint x="320" y="808" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_fork_final_di" bpmnElement="e_fork_final">
        <di:waypoint x="320" y="650" />
        <di:waypoint x="570" y="808" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_design_join_di" bpmnElement="e_design_join">
        <di:waypoint x="100" y="808" />
        <di:waypoint x="320" y="960" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_biz_join_di" bpmnElement="e_biz_join">
