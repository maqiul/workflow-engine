      <bpmndi:BPMNShape id="parallelGateway_3_di" bpmnElement="parallelGateway_3">
        <dc:Bounds x="276" y="1155" width="60" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="userTask_7_di" bpmnElement="userTask_7">
        <dc:Bounds x="410" y="1250" width="160" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="write_epc_di" bpmnElement="write_epc">
        <dc:Bounds x="46" y="1262" width="160" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_confirm_di" bpmnElement="gw_confirm">
        <dc:Bounds x="290" y="370" width="60" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_approve_di" bpmnElement="endEvent_approve">
        <dc:Bounds x="280" y="1770" width="52" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="final_review_di" bpmnElement="final_review">
        <dc:Bounds x="490" y="780" width="160" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="design_review_di" bpmnElement="design_review">
        <dc:Bounds x="20" y="780" width="160" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="startEvent_di" bpmnElement="startEvent">
        <dc:Bounds x="280" y="40" width="52" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_parallel_fork_di" bpmnElement="gw_parallel_fork">
        <dc:Bounds x="290" y="620" width="60" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="biz_review_di" bpmnElement="biz_review">
        <dc:Bounds x="240" y="780" width="160" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="resubmit_1_di" bpmnElement="resubmit_1">
        <dc:Bounds x="714" y="314" width="160" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="loop_temple_node_di" bpmnElement="loop_temple_node">
        <dc:Bounds x="230" y="1554" width="160" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="loop_cc_node_di" bpmnElement="loop_cc_node">
        <dc:Bounds x="230" y="1630" width="160" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="loop_node_loop_gw_di" bpmnElement="loop_node_loop_gw">
        <dc:Bounds x="280" y="1766" width="60" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="e1_di" bpmnElement="e1">
        <di:waypoint x="306" y="66" />
        <di:waypoint x="320" y="168" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e2_di" bpmnElement="e2">
